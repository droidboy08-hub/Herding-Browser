# Xcode build output (regenerable — ~230 MB)
prototype/build/
prototype/build-device/
prototype/build-release/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/

# Reference checkout of Brave iOS, consulted for how their adblock layers are
# wired. 1.3 GB, has its own .git, and is not part of this app.
vendor/brave-ios/

# Rust build artifacts (regenerable — ~460 MB)
adblock-ffi/target/
# Generated by build-xcframework.sh. The staging copy and the cbindgen output are
# byproducts; the framework that gets committed is the installed one at
# prototype/Frameworks/AdblockFFI.xcframework, so a clone can build the app
# without a Rust toolchain.
adblock-ffi/AdblockFFI.xcframework/
adblock-ffi/include/

# macOS
.DS_Store
